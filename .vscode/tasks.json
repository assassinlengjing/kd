{
	"version": "2.0.0",
	"tasks": [
	  {
		"label": "build with cl",
		"type": "shell",
		"command": "cl",
		"args": [
		  "/EHsc",                    // 启用 C++ 异常处理
		  "/std:c++20",               // 使用 C++20 标准
		  "/w",                       // 禁止显示警告
		  "/I", 
		  "D:\\Users\\lengjing\\source\\repos\\kd\\kd",
		  "/Fe:",                     // 指定输出文件名
		  "D:\\Users\\lengjing\\source\\repos\\kd\\kd.exe", // 输出可执行文件路径
		  "${workspaceFolder}/kd/*.cpp" ,   // 包含所有源文件
		  "/link",
		  "winmm.lib",
		  "Ddraw.lib",
		  "dsound.lib",
		  "kernel32.lib",
		  "user32.lib", "gdi32.lib", "winspool.lib", "comdlg32.lib", "advapi32.lib", "shell32.lib",  "ole32.lib", "oleaut32.lib", "uuid.lib", "odbc32.lib", "odbccp32.lib",
		  "/SUBSYSTEM:CONSOLE",  // 指定为控制台子系统
		  "/DEBUG",  // 生成调试信息
		  "/Zi"
		],
		"group": {
		  "kind": "build",
		  "isDefault": true
		},
		"problemMatcher": ["$msCompile"],
		"detail": "Compile with cl.exe using C++20 standard"
	  }
	]
  }
  //cl /EHsc /std:c++20 /w /I "D:\\Users\\lengjing\\source\\repos\\kd\\kd" "D:\Users\lengjing\source\repos\kd\kd\*.cpp" /Fe:D:\\Users\\lengjing\\source\\repos\\kd\\hello.exe  /link  winmm.lib Ddraw.lib dsound.lib kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib  ole32.lib oleaut32.lib uuid.lib odbc32.lib  odbccp32.lib
  //cl /EHsc /std:c++20 "D:\\Users\\lengjing\\source\\repos\\kd\\hello.cpp" /Fe:D:\\Users\\lengjing\\source\\repos\\kd\\hello.exe
